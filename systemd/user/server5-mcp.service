[Unit]
Description=Server5 owner-only MCP adapter with confirmed queue submission
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/mau/server5-commandcenter
ExecStart=/home/mau/.local/share/server5-commandcenter/mcp-venv/bin/python /home/mau/server5-commandcenter/web/mcp_adapter.py --enable-start-task
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mau/.local/state/server5-commandcenter/mvp
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=256M
CPUQuota=50%
TasksMax=32
TimeoutStopSec=15

[Install]
WantedBy=default.target
