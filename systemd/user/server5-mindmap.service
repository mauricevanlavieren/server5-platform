[Unit]
Description=Server5 LAN-only local Markmap viewer
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/mau/server5-commandcenter/mindmap
ExecStart=/usr/bin/python3 /home/mau/server5-commandcenter/mindmap/serve.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=default.target
